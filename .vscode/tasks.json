{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "plan-monitor: npm install",
            "type": "shell",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1,
                "instancePolicy": "silent"
            }
        },
        {
            "label": "plan-monitor: npm clean",
            "type": "shell",
            "command": "npm run clean",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "plan-monitor: npm install"
            ],
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1,
                "instancePolicy": "silent"
            }
        },
        {
            "label": "plan-monitor: npm watch",
            "type": "shell",
            "command": "npm run build -- --watch",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "plan-monitor: npm clean"
            ],
            "isBackground": true,
            "problemMatcher": "$tsc-watch",
            "runOptions": {
                "instanceLimit": 1,
                "instancePolicy": "silent"
            }
        },
        {
            "label": "plan-monitor: app start",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "plan-monitor: npm watch"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "node-ts",
                "severity": "info",
                "pattern": {
                    "regexp": ".*",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*plan-monitor started.*"
                }
            },
            "runOptions": {
                "instanceLimit": 1,
                "instancePolicy": "silent"
            }
        }
    ]
}