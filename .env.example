# Local app configuration for plan-monitor

# Global monitor settings
MONITOR_INTERVAL_MINUTES=30
DISABLED_PROVIDERS=

# Provider-specific credential or token names. The app never persists secrets itself;
# values are read from the environment at runtime.
GITHUB_COPILOT_TOKEN=
CURSOR_API_KEY=
CLAUDE_CODE_API_KEY=
CODEX_API_KEY=

# Optional raw provider payload fixtures used in testing.
GITHUB_COPILOT_PAYLOAD=
CURSOR_PAYLOAD=
CLAUDE_CODE_PAYLOAD=
CODEX_PAYLOAD=
